---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
const items = [
  ['Payment terms', 'Packages up to KSh 54,999: 50% to begin and 50% before final handover. Custom and enterprise work: milestone payments agreed in the written scope. We accept M-Pesa, bank transfer and card.'],
  ['Ownership', 'On final payment, you own the design, source code, content and all accounts. Domains are registered in your name.'],
  ['Revisions', 'Each package includes up to two structured revision rounds. Further changes are quoted per task before work starts.'],
  ['Timelines', 'Timelines start when we receive your content and the first payment. Delays caused by late content move the schedule, not the price.'],
  ['Support and fixes', 'Free post-launch support ranges from 14 days to 6 months depending on the package. We fix any bug in delivered scope at no cost during that window.'],
  ['Refunds', 'If we cannot deliver the agreed scope, you receive a refund for undelivered milestones. Completed and approved milestones are non-refundable.'],
  ['Privacy and confidentiality', 'We keep your business data confidential and sign an NDA on request. We only use your data to deliver the project.'],
  ['SEO honesty', 'We build for search visibility but never promise specific rankings, because search engines control them.'],
];
---
<Base title="Policies: Payment, Ownership, Support & Refunds | Nairobi Web Developers" description="Clear policies from a genuine Nairobi web developer: payment terms, code ownership, revisions, support windows, refunds and confidentiality." schema={[]}>
<div class="wrap pagehead"><h1>Our policies, in plain language</h1><p>Clear terms are part of being reliable. These apply to every project unless your written scope says otherwise.</p></div>
<section><div class="wrap" style="max-width:820px">{items.map(([t, d]) => <div class="reveal" style="padding:1.3rem 0;border-bottom:1px solid var(--line)"><h3>{t}</h3><p class="mute" style="margin-top:.4rem">{d}</p></div>)}</div></section>
<CtaBand />
</Base>

---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, waLink } from '../data/site';
import { areas } from '../data/areas';
import { services } from '../data/services';
interface Props { title: string; description: string; schema?: object[]; noindex?: boolean }
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': SITE.url + '/#org',
  name: SITE.name, url: SITE.url, telephone: SITE.phone, email: SITE.email, image: SITE.url + '/favicon.svg',
  priceRange: 'KSh 9,999 – KSh 120,000', description: 'Reliable, affordable and professional web development in Nairobi, Kenya.',
  address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
  areaServed: areas.map((a) => ({ '@type': 'Place', name: a.name + ', Nairobi' })),
  contactPoint: { '@type': 'ContactPoint', telephone: SITE.phone, contactType: 'sales', availableLanguage: ['English', 'Swahili'] },
};
const path = Astro.url.pathname;
const nav = [['/pricing', 'Pricing'], ['/services/business-website', 'Services'], ['/areas/westlands', 'Areas'], ['/faq', 'FAQ'], ['/policies', 'Policies']];
---
<!doctype html>
<html lang="en-KE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:locale" content="en_KE" /><meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary" />
  <meta name="geo.region" content="KE-110" /><meta name="geo.placename" content="Nairobi" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  {[org, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <ClientRouter />
</head>
<body>
  <header class="top"><div class="wrap">
    <a class="logo" href="/"><i></i>Nairobi Web Developers</a>
    <nav class="main" aria-label="Main">{nav.map(([h, l]) => <a href={h} aria-current={path.startsWith(h.split('/').slice(0,2).join('/')) ? 'page' : undefined}>{l}</a>)}</nav>
    <a class="btn sm" href="/book">Book a call</a>
  </div></header>
  <main><slot /></main>
  <footer><div class="wrap cols">
    <div><a class="logo" href="/"><i></i>Nairobi Web Developers</a>
      <p class="mute" style="margin-top:.8rem">Reliable, affordable and professional web development for businesses in Nairobi and across Kenya.</p>
      <p style="margin-top:.8rem"><a href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a><a href={waLink('Hi, I need a website.')}>WhatsApp {SITE.phoneDisplay}</a></p></div>
    <div><h3>Services</h3>{services.map((s) => <a href={`/services/${s.slug}`}>{s.name}</a>)}</div>
    <div><h3>Areas</h3>{areas.map((a) => <a href={`/areas/${a.slug}`}>{a.name}</a>)}</div>
    <div><h3>Company</h3><a href="/pricing">Pricing</a><a href="/faq">FAQ</a><a href="/policies">Policies</a><a href="/book">Book a call</a><a href="/llms.txt">llms.txt</a></div>
  </div></footer>
  <div class="float"><a class="btn sm" href={`tel:${SITE.phone}`} aria-label="Call us">Call</a><a class="btn sm wa" href={waLink('Hi, I found you online and need a website.')} aria-label="WhatsApp us">WhatsApp</a></div>
  <script>
    document.addEventListener('astro:page-load', () => {
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) return els.forEach((e) => e.classList.add('in'));
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .12 });
      els.forEach((e) => io.observe(e));
    });
  </script>
</body>
</html>
